        <mxCell id="n_g2" value="DAG train_star_model · entrenamiento manual · parámetros: n_trials=250, seed=42, snapshot_sha256, min_delta=0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#8a8a8a;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;arcSize=2;container=1;collapsible=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="400" width="1040" height="330" as="geometry"/></mxCell>
        <mxCell id="n_sdss" value="&lt;b&gt;SDSS DR17&lt;/b&gt;&lt;br&gt;API SQL por HTTPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="n_g1"><mxGeometry x="30" y="32" width="170" height="46" as="geometry"/></mxCell>
        <mxCell id="n_descargar" value="&lt;b&gt;descargar_muestra&lt;/b&gt;&lt;br&gt;1000 objetos aleatorios&lt;br&gt;(ORDER BY NEWID())" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="n_g1"><mxGeometry x="30" y="110" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="n_revisar" value="&lt;b&gt;revisar_clases&lt;/b&gt;&lt;br&gt;(@task.branch)&lt;br&gt;cuenta las filas por clase y&lt;br&gt;compara la más escasa con&lt;br&gt;min_rows_per_class" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe599;strokeColor=#bf9000;fontSize=11;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="n_g1"><mxGeometry x="280" y="105" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="n_remuestrear" value="&lt;b&gt;remuestrear&lt;/b&gt;&lt;br&gt;hasta 3 descargas en total&lt;br&gt;(contando la primera); conserva&lt;br&gt;la de clase más escasa mayor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="n_g1"><mxGeometry x="540" y="235" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="n_guardar" value="&lt;b&gt;guardar_snapshot&lt;/b&gt;&lt;br&gt;guarda el CSV en MinIO y&lt;br&gt;registra la ingesta en MLflow&lt;br&gt;(corre tras cualquiera de&lt;br&gt;los dos caminos)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="n_g1"><mxGeometry x="820" y="105" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="n_minio" value="&lt;b&gt;MinIO (S3)&lt;/b&gt;&lt;br&gt;raw/star/starset.csv&lt;br&gt;raw/star/snapshots/&lt;sha256&gt;.csv&lt;br&gt;training/star/&lt;hash&gt;/&lt;br&gt;(checkpoints del entrenamiento)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1100" y="100" width="220" height="150" as="geometry"/></mxCell>
        <mxCell id="n_mlflow" value="&lt;b&gt;MLflow · experimento star type&lt;/b&gt;&lt;br&gt;run de ingesta (stage=ingestion,&lt;br&gt;dataset.sha256)&lt;br&gt;runs de búsqueda y entrenamiento&lt;br&gt;modelo star_type_model_prod&lt;br&gt;con el alias champion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1100" y="400" width="220" height="160" as="geometry"/></mxCell>
        <mxCell id="n_t1" value="&lt;b&gt;resolve_snapshot&lt;/b&gt;&lt;br&gt;toma la última ingesta exitosa&lt;br&gt;(o el hash indicado) y verifica&lt;br&gt;la integridad del CSV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="n_g2"><mxGeometry x="20" y="40" width="290" height="80" as="geometry"/></mxCell>
        <mxCell id="n_t2" value="&lt;b&gt;search_hyperparameters&lt;/b&gt;&lt;br&gt;Optuna con validación cruzada&lt;br&gt;de 5 folds; un run hijo en MLflow&lt;br&gt;por cada prueba" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="n_g2"><mxGeometry x="360" y="40" width="290" height="80" as="geometry"/></mxCell>
        <mxCell id="n_t3" value="&lt;b&gt;train_and_log_model&lt;/b&gt;&lt;br&gt;entrena el Pipeline completo&lt;br&gt;(scaler + modelo) con los mejores&lt;br&gt;hiperparámetros" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="n_g2"><mxGeometry x="700" y="40" width="290" height="80" as="geometry"/></mxCell>
        <mxCell id="n_t4" value="&lt;b&gt;evaluate_candidate&lt;/b&gt;&lt;br&gt;recarga el modelo y mide F1&lt;br&gt;weighted y macro en el&lt;br&gt;conjunto de test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="n_g2"><mxGeometry x="20" y="170" width="290" height="80" as="geometry"/></mxCell>
        <mxCell id="n_t5" value="&lt;b&gt;register_candidate&lt;/b&gt;&lt;br&gt;crea una versión nueva de&lt;br&gt;star_type_model_prod, sin&lt;br&gt;mover el alias champion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="n_g2"><mxGeometry x="360" y="170" width="290" height="80" as="geometry"/></mxCell>
        <mxCell id="n_t6" value="&lt;b&gt;compare_and_promote_champion&lt;/b&gt;&lt;br&gt;compara candidato y champion&lt;br&gt;en el mismo test; promueve solo&lt;br&gt;si el F1 weighted mejora" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="n_g2"><mxGeometry x="700" y="170" width="290" height="80" as="geometry"/></mxCell>
